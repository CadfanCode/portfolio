# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Claude Code: the agent roster and arbiter config are shared, the local
# permission grants are not -- `*.local` above does not match `*.local.json`.
.claude/settings.local.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Blender: the .blend and the renders are build artifacts, regenerated by
# `npm run model:build`. Reference photos are third-party material -- cited in
# blender/refs/SOURCES.md, not redistributed here.
blender/*.blend
blender/*.blend[0-9]
blender/renders/
blender/refs/*
!blender/refs/SOURCES.md
__pycache__/
