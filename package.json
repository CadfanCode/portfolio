{
  "name": "portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "model:build": "flatpak run org.blender.Blender -b --factory-startup --python \"$PWD/blender/build.py\" -- --project \"$PWD\"",
    "model:verify": "flatpak run org.blender.Blender -b --factory-startup --python \"$PWD/blender/verify.py\" -- --project \"$PWD\"",
    "model:preview": "flatpak run org.blender.Blender -b --factory-startup --python \"$PWD/blender/preview.py\" -- --project \"$PWD\"",
    "model:preview:interior": "flatpak run org.blender.Blender -b --factory-startup --python \"$PWD/blender/preview.py\" -- --project \"$PWD\" --views interior"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "postprocessing": "^6.39.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
